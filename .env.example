NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used to embed questions and name new topics. Never expose this to the browser.
OPENAI_API_KEY=sk-...
# Optional model overrides. The embedding model must return 1536 dimensions.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TOPIC_MODEL=gpt-4o-mini

# Default cosine similarity for new events (organizers can change it per event).
QUESTION_SIMILARITY_THRESHOLD=0.82

# Where question clustering runs: "edge" (Supabase Edge Function `group-question`, default)
# or "api" (Next.js route /api/questions/group). Edge falls back to the API route if the
# function is not deployed yet.
# NEXT_PUBLIC_CLUSTERING_BACKEND=edge

# Public address for the attendee QR code and share link, e.g. your deployed URL.
# When unset on localhost, the QR code uses this machine's Wi-Fi address instead.
# NEXT_PUBLIC_SITE_URL=https://asklive.example.com
